// ==UserScript==
// @name         SF Pro + PingFang SC + SF Mono（防闪烁版）
// @namespace    local.apple.fonts
// @version      3.0.0
// @description  英文使用 SF Pro，中文使用 PingFang SC，代码使用 SF Mono，并保护网页图标
// @match        http://*/*
// @match        https://*/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const ICON_MARK = 'data-tm-preserve-icon-font';

    const glyphFontPattern =
        /icon|glyph|symbol|awesome|fontello|icomoon|comm_|material|codicon|font[-_]?awesome/i;

    const iconSelector = [
        'svg',
        'path',
        'use',
        '[aria-hidden="true"]',
        '[role="img"]',
        '[data-icon]',
        '[data-lucide]',
        '[data-feather]',
        '[class*="icon"]',
        '[class*="Icon"]',
        '[class*="material"]',
        '[class*="symbols"]',
        '[class*="fa-"]',
        '[class*="bi-"]',
        '[class*="ri-"]',
        '[class*="mdi-"]',
        '[class*="glyphicon"]',
        '[class*="anticon"]',
        '[class*="codicon"]',
        '[class*="iconify"]'
    ].join(',');

    /*
     * 页面刚开始加载时，先排除：
     * - SVG 图标
     * - 常见图标 class
     * - 直接声明了 font-family 的元素
     *
     * 这样 comm_glyphs 等图标字体不会先被 SF Pro 覆盖。
     */
    const earlyTextSelector = [
        `body *:not([${ICON_MARK}])`,
        ':not([style*="font-family"])',
        ':not(svg)',
        ':not(path)',
        ':not(use)',
        ':not([aria-hidden="true"])',
        ':not([role="img"])',
        ':not([data-icon])',
        ':not([class*="icon"])',
        ':not([class*="Icon"])',
        ':not([class*="material"])',
        ':not([class*="symbols"])',
        ':not([class*="fa-"])',
        ':not([class*="bi-"])',
        ':not([class*="ri-"])',
        ':not([class*="mdi-"])',
        ':not([class*="glyphicon"])',
        ':not([class*="anticon"])',
        ':not([class*="codicon"])',
        ':not([class*="iconify"])'
    ].join('');

    const editorSelectors = [
        'html body .monaco-editor .view-lines',
        'html body .monaco-editor .view-lines *:not(svg):not(path):not(use)',

        'html body .CodeMirror .CodeMirror-code',
        'html body .CodeMirror .CodeMirror-code *:not(svg):not(path):not(use)',

        'html body .cm-editor .cm-content',
        'html body .cm-editor .cm-content *:not(svg):not(path):not(use)',

        'html body .ace_editor .ace_text-layer',
        'html body .ace_editor .ace_text-layer *:not(svg):not(path):not(use)',

        'html body .ace_editor .ace_gutter',
        'html body .jsoneditor-text',
        'html body .jsoneditor-text *:not(svg):not(path):not(use)'
    ].join(',\n');

    const style = document.createElement('style');
    style.id = 'tm-apple-font-style';

    style.textContent = `
        /*
         * 普通网页文字：
         * 英文、数字优先 SF Pro；
         * 中文回退 PingFang SC。
         */
        :where(${earlyTextSelector}) {
            font-family: "SF Pro", "PingFang SC", sans-serif !important;
        }

        /*
         * 普通代码区域
         */
        pre,
        pre *,
        code,
        code *,
        kbd,
        samp {
            font-family: "SF Mono", Consolas, monospace !important;
            font-variant-ligatures: none !important;
        }

        /*
         * 常见代码编辑器
         */
        ${editorSelectors} {
            font-family: "SF Mono", Consolas, monospace !important;
            font-variant-ligatures: none !important;
        }
    `;

    function injectStyle() {
        const root = document.documentElement;

        if (!root) {
            return;
        }

        if (!document.getElementById(style.id)) {
            root.insertBefore(style, root.firstChild);
        }
    }

    // 尽早注入，减少页面初始闪烁
    injectStyle();

    function markIcon(element) {
        if (element instanceof Element) {
            element.setAttribute(ICON_MARK, '1');
        }
    }

    function protectInlineGlyphFonts(root = document) {
        root.querySelectorAll('[style*="font-family"]').forEach(element => {
            const inlineFont = element.style.fontFamily || '';
            const text = (element.textContent || '').trim();

            if (
                glyphFontPattern.test(inlineFont) ||
                (!text && inlineFont)
            ) {
                markIcon(element);
            }
        });
    }

    function hasIconPseudo(element) {
        for (const pseudo of ['::before', '::after']) {
            const computed = getComputedStyle(element, pseudo);
            const content = computed.content || '';
            const fontFamily = computed.fontFamily || '';

            if (
                content === 'none' ||
                content === 'normal' ||
                content === '""'
            ) {
                continue;
            }

            if (
                glyphFontPattern.test(`${fontFamily} ${content}`) ||
                /\\[ef][0-9a-f]{3,6}/i.test(content) ||
                /[\uE000-\uF8FF]/.test(content)
            ) {
                return true;
            }
        }

        return false;
    }

    function protectIcons() {
        document.querySelectorAll(iconSelector).forEach(markIcon);

        // 保护 comm_glyphs、Fontello、IcoMoon 等内联图标字体
        protectInlineGlyphFonts();

        // 保护通过 ::before / ::after 生成的图标
        document
            .querySelectorAll('[class], a, button, li')
            .forEach(element => {
                if (hasIconPseudo(element)) {
                    markIcon(element);
                }
            });
    }

    function refreshEditors() {
        window.dispatchEvent(new Event('resize'));

        // CodeMirror 5
        document.querySelectorAll('.CodeMirror').forEach(element => {
            const editor = element.CodeMirror;

            if (editor && typeof editor.refresh === 'function') {
                editor.refresh();
            }
        });

        // Monaco
        if (
            window.monaco &&
            window.monaco.editor &&
            typeof window.monaco.editor.getEditors === 'function'
        ) {
            window.monaco.editor.getEditors().forEach(editor => {
                if (editor && typeof editor.layout === 'function') {
                    editor.layout();
                }
            });
        }

        // Ace
        document.querySelectorAll('.ace_editor').forEach(element => {
            if (
                element.env &&
                element.env.editor &&
                typeof element.env.editor.resize === 'function'
            ) {
                element.env.editor.resize(true);
            }
        });
    }

    function scheduleEditorRefresh() {
        setTimeout(refreshEditors, 200);
        setTimeout(refreshEditors, 800);
        setTimeout(refreshEditors, 1600);
    }

    // 页面结构准备好后识别图标
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            protectIcons();
            scheduleEditorRefresh();
        }, { once: true });
    } else {
        protectIcons();
        scheduleEditorRefresh();
    }

    // 字体加载完成后再次刷新编辑器
    if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(scheduleEditorRefresh);
    }

    // 处理动态加载的新图标
    let protectTimer;

    new MutationObserver(() => {
        clearTimeout(protectTimer);

        protectTimer = setTimeout(() => {
            protectIcons();
        }, 200);
    }).observe(document.documentElement, {
        childList: true,
        subtree: true
    });
})();
